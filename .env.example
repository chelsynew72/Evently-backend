# Database (Neon connection string — use the "pooled" connection for app runtime)
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/evently?sslmode=require"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRY="30d"

# Cloudinary (free tier — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe (test mode keys — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# App
PORT=3000
CORS_ORIGIN="http://localhost:3000"

# OTP token used to sign/verify QR codes — separate from JWT secrets
QR_SIGNING_SECRET="replace-with-another-long-random-string"
